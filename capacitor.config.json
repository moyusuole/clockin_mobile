{
  "appId": "com.you.checkin",
  "appName": "每日打卡",
  "webDir": "public",
  "plugins": {
    "CapacitorUpdater": {
      "updateUrl": "https://clockin-update-server.onrender.com/updates",
      "autoUpdate": "off",
      "allowModifyUrl": true,
      "resetWhenUpdate": true,
      "autoDeletePrevious": true,
      "autoDeleteFailed": true,
      "persistModifyUrl": true,
      "appReadyTimeout": 10000,
      "responseTimeout": 20
    }
  }
}
